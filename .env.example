# Copiar este archivo como .env en el VPS y completar los valores reales
# El archivo .env NUNCA se sube al repositorio

SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,IP_DEL_VPS
# Con HTTPS (con http:// no hace falta). Incluir el esquema:
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Base de datos MySQL
DB_NAME=conciliaciones_db
DB_USER=conciliaciones_user
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=3306

# Origen de datos GOBS (PostgreSQL en AWS RDS, usuario de solo lectura).
# Con GOBS_PG_ENABLED=False la app pide los Excel como antes.
# Requiere que la IP de este servidor esté autorizada en el RDS (pedirlo al equipo GOBS).
GOBS_PG_ENABLED=False
GOBS_PG_HOST=
GOBS_PG_PORT=5432
GOBS_PG_DB=gobs
GOBS_PG_USER=
GOBS_PG_PASSWORD=
GOBS_PG_SSLMODE=require

# Caldas Declare y Pague: dejar en False hasta que GOBS cargue las actividades ICA de Caldas.
# Comprobar con: python manage.py verificar_gobs --municipio CALDAS  (con_actividades ~100%)
GOBS_PG_CALDAS_DECLARE=False
