# Copiar este archivo como .env en el VPS y completar los valores reales
# El archivo .env NUNCA se sube al repositorio

SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,IP_DEL_VPS
# Con HTTPS (con http:// no hace falta). Incluir el esquema:
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Base de datos MySQL
DB_NAME=conciliaciones_db
DB_USER=conciliaciones_user
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=3306

# Origen de datos GOBS (PostgreSQL en AWS RDS, usuario de solo lectura).
# Con GOBS_PG_ENABLED=False la app pide los Excel como antes.
# Requiere que la IP de este servidor esté autorizada en el RDS (pedirlo al equipo GOBS).
GOBS_PG_ENABLED=False
GOBS_PG_HOST=
GOBS_PG_PORT=5432
GOBS_PG_DB=gobs
GOBS_PG_USER=
GOBS_PG_PASSWORD=
GOBS_PG_SSLMODE=require

# Caldas Declare y Pague: dejar en False hasta que GOBS cargue las actividades ICA de Caldas.
# Comprobar con: python manage.py verificar_gobs --municipio CALDAS  (con_actividades ~100%)
GOBS_PG_CALDAS_DECLARE=False

# Correo saliente: recuperación de contraseña y alta de usuarios (SMTP).
# Sin EMAIL_HOST los correos no se envían (solo salen en el log del servidor).
# Opciones gratuitas: Brevo (300/día), Gmail con contraseña de aplicación (500/día) o el
# correo de tu propio servidor. Ejemplo Brevo:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sistema de CXC <noreply@filosdev.com>
# Dirección pública de la app (va dentro del correo) y vigencia de la contraseña temporal
SITE_URL=https://conciliaciones.filosdev.com
PASSWORD_TEMPORAL_HORAS=24

# Remitente de las exportaciones por correo (botón "Enviar por correo" en Ver datos).
# Debe estar verificado como remitente en Brevo; para que no caiga en spam, autentica también su dominio.
EXPORT_FROM_EMAIL=Brian Filos <brian.filos@gobs.com.co>
EXPORT_MAX_ADJUNTOS_MB=10
# Si el remitente aún no está autenticado en Brevo, envía desde un remitente verificado y recibe las respuestas aquí:
# EXPORT_REPLY_TO=brian.filos@gobs.com.co

# ── Seguridad (todos opcionales; estos son los valores por defecto) ──────────
# Minutos sin actividad antes de pedir el ingreso de nuevo (además, la sesión muere al cerrar el navegador)
SESION_INACTIVIDAD_MIN=60
# Cierra la sesión si el sitio se abre en una pestaña nueva (pestaña cerrada y vuelta a entrar)
SESION_POR_PESTANA=True
# Bloqueo temporal tras intentos fallidos de ingreso (ventana en minutos)
LOGIN_VENTANA_MIN=15
LOGIN_MAX_INTENTOS_USUARIO=6
LOGIN_MAX_INTENTOS_IP=20
# Ruta del panel de Django. Cámbiala por algo no evidente, p. ej. ADMIN_URL=panel-9f3k2/
ADMIN_URL=django-admin/
# Tamaño máximo por archivo subido (MB)
UPLOAD_MAX_MB=60
# Con HTTPS funcionando y probado puedes forzar el redirect desde Django (Nginx ya suele hacerlo)
SECURE_SSL_REDIRECT=False
